# Copy to .env and fill in real values before running docker-compose
# NEVER commit .env to version control

# JWT — must be at least 256 bits (32 chars)
JWT_SECRET=healthconnect-super-secret-key-change-in-production-min-256-bits

# Eureka credentials
EUREKA_USER=eureka
EUREKA_PASSWORD=eureka-secret

# PostgreSQL
DB_USER=healthconnect
DB_PASSWORD=healthconnect

# Redis (if password protected)
REDIS_PASSWORD=redissecret

# AWS (for document-service S3 integration)
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=healthconnect-documents-local
